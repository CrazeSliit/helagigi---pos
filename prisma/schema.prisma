// HeladiGi POS. Money is Decimal(14,2), quantities Decimal(14,3) so loose goods work.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductUnitKind {
  COUNT
  WEIGHT
  VOLUME
}

enum SaleStatus {
  COMPLETED
  ON_CREDIT
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  LANKAQR
  CREDIT
  GIFT_CARD
  LOYALTY
}

enum MovementType {
  OPENING
  SALE
  SALE_RETURN
  VOID
  PURCHASE
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  STOCK_TAKE
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockTakeStatus {
  OPEN
  POSTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
  APPROVED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum PromotionType {
  PERCENTAGE
  FIXED
  BUY_X_GET_Y
  BUNDLE
  HAPPY_HOUR
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CustomerTier {
  SILVER
  GOLD
  PLATINUM
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLEANING
}

enum KotStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

// ---------- Organisation & access ----------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminals     Terminal[]
  users         UserBranch[]
  stock         Stock[]
  batches       Batch[]
  movements     StockMovement[]
  sales         Sale[]
  returns       SaleReturn[]
  heldOrders    HeldOrder[]
  shifts        Shift[]
  expenses      Expense[]
  purchaseOrders PurchaseOrder[]
  grns          Grn[]
  purchaseReturns PurchaseReturn[]
  stockTakes    StockTake[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  tables        DiningTable[]
  kots          Kot[]
  attendance    Attendance[]
}

model Terminal {
  id         String    @id @default(cuid())
  branchId   String
  name       String
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  branch Branch  @relation(fields: [branchId], references: [id])
  shifts Shift[]
  sales  Sale[]

  @@unique([branchId, name])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  system      Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  username       String?   @unique
  name           String
  phone          String?
  color          String    @default("#1A3170")
  passwordHash   String?
  pinHash        String?
  active         Boolean   @default(true)
  allBranches    Boolean   @default(false)
  commissionRate Decimal   @default(0) @db.Decimal(5, 2)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  roleId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role        Role            @relation(fields: [roleId], references: [id])
  branches    UserBranch[]
  sessions    Session[]
  resetTokens PasswordReset[]
  sales       Sale[]          @relation("SaleCashier")
  shifts      Shift[]
  attendance  Attendance[]
  auditLogs   AuditLog[]
  notifications Notification[]
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  branchId   String?
  terminalId String?
  locked     Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A terminal trusted via password sign-in. PIN login only works from these.
model TrustedDevice {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  branchId    String
  terminalId  String?
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  branchId   String
  clockIn    DateTime  @default(now())
  clockOut   DateTime?
  note       String?
  user       User      @relation(fields: [userId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])

  @@index([userId, clockIn])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  branchId  String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  branchId  String?
  type      String
  tone      String    @default("info")
  icon      String?
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Upload {
  id          String   @id @default(cuid())
  key         String   @unique
  contentType String
  size        Int?
  purpose     String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

// ---------- Catalogue ----------

model Category {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  nameSi String?
  nameTa String?
  icon   String?
  color  String?
  active Boolean @default(true)
  products Product[]
}

model Brand {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  products Product[]
}

model Unit {
  id     String          @id @default(cuid())
  code   String          @unique
  name   String
  kind   ProductUnitKind @default(COUNT)
  products Product[]
}

model TaxRate {
  id     String  @id @default(cuid())
  name   String  @unique
  rate   Decimal @db.Decimal(5, 2)
  onReceipt Boolean @default(true)
  active Boolean @default(true)
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  barcode      String?  @unique
  name         String
  nameSi       String?
  nameTa       String?
  description  String?
  categoryId   String
  brandId      String?
  unitId       String
  taxRateId    String?
  price        Decimal  @db.Decimal(14, 2)
  cost         Decimal  @default(0) @db.Decimal(14, 2)
  mrp          Decimal? @db.Decimal(14, 2)
  reorderLevel Decimal  @default(0) @db.Decimal(14, 3)
  icon         String?
  imageKey     String?
  weighed      Boolean  @default(false)
  favorite     Boolean  @default(false)
  trackStock   Boolean  @default(true)
  variantGroups Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  taxRate  TaxRate? @relation(fields: [taxRateId], references: [id])
  stock     Stock[]
  batches   Batch[]
  movements StockMovement[]
  saleItems SaleItem[]
  poItems   PurchaseOrderItem[]
  grnItems  GrnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  transferItems StockTransferItem[]
  stockTakeItems StockTakeItem[]
  kotItems  KotItem[]

  @@index([name])
  @@index([categoryId])
}

// ---------- Inventory ----------

model Stock {
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@id([branchId, productId])
  @@index([productId])
}

model Batch {
  id        String    @id @default(cuid())
  branchId  String
  productId String
  batchNo   String
  expiresAt DateTime?
  quantity  Decimal   @db.Decimal(14, 3)
  cost      Decimal   @default(0) @db.Decimal(14, 2)
  createdAt DateTime  @default(now())
  branch    Branch    @relation(fields: [branchId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([branchId, productId, batchNo])
  @@index([expiresAt])
}

model StockMovement {
  id        String       @id @default(cuid())
  branchId  String
  productId String
  type      MovementType
  quantity  Decimal      @db.Decimal(14, 3)
  balance   Decimal      @db.Decimal(14, 3)
  unitCost  Decimal?     @db.Decimal(14, 2)
  reason    String?
  refType   String?
  refId     String?
  userId    String?
  createdAt DateTime     @default(now())
  branch    Branch       @relation(fields: [branchId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])

  @@index([branchId, productId, createdAt])
  @@index([createdAt])
}

model StockTransfer {
  id           String         @id @default(cuid())
  number       String         @unique
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(IN_TRANSIT)
  note         String?
  createdById  String?
  receivedById String?
  receivedAt   DateTime?
  createdAt    DateTime       @default(now())
  fromBranch   Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch     Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  items        StockTransferItem[]
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal       @db.Decimal(14, 3)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])
}

model StockTake {
  id          String          @id @default(cuid())
  number      String          @unique
  branchId    String
  status      StockTakeStatus @default(OPEN)
  note        String?
  createdById String?
  postedAt    DateTime?
  createdAt   DateTime        @default(now())
  branch      Branch          @relation(fields: [branchId], references: [id])
  items       StockTakeItem[]
}

model StockTakeItem {
  id          String    @id @default(cuid())
  stockTakeId String
  productId   String
  expected    Decimal   @db.Decimal(14, 3)
  counted     Decimal?  @db.Decimal(14, 3)
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([stockTakeId, productId])
}

// ---------- Purchasing ----------

model Supplier {
  id          String   @id @default(cuid())
  name        String   @unique
  contact     String?
  phone       String?
  email       String?
  address     String?
  vatNo       String?
  paymentTermsDays Int @default(30)
  outstanding Decimal  @default(0) @db.Decimal(14, 2)
  active      Boolean  @default(true)
  onHold      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      PurchaseOrder[]
  grns        Grn[]
  payments    SupplierPayment[]
  returns     PurchaseReturn[]
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String
  branchId    String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  note        String?
  total       Decimal             @default(0) @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  items       PurchaseOrderItem[]
  grns        Grn[]
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal       @db.Decimal(14, 3)
  received  Decimal       @default(0) @db.Decimal(14, 3)
  unitCost  Decimal       @db.Decimal(14, 2)
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Grn {
  id          String         @id @default(cuid())
  number      String         @unique
  supplierId  String
  branchId    String
  orderId     String?
  invoiceNo   String?
  total       Decimal        @db.Decimal(14, 2)
  note        String?
  receivedById String?
  createdAt   DateTime       @default(now())
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  branch      Branch         @relation(fields: [branchId], references: [id])
  order       PurchaseOrder? @relation(fields: [orderId], references: [id])
  items       GrnItem[]
}

model GrnItem {
  id        String    @id @default(cuid())
  grnId     String
  productId String
  quantity  Decimal   @db.Decimal(14, 3)
  unitCost  Decimal   @db.Decimal(14, 2)
  batchNo   String?
  expiresAt DateTime?
  grn       Grn       @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  number     String   @unique
  supplierId String
  amount     Decimal  @db.Decimal(14, 2)
  method     String
  reference  String?
  note       String?
  paidById   String?
  paidAt     DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model PurchaseReturn {
  id         String   @id @default(cuid())
  number     String   @unique
  supplierId String
  branchId   String
  total      Decimal  @db.Decimal(14, 2)
  reason     String?
  createdById String?
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  items      PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id        String         @id @default(cuid())
  returnId  String
  productId String
  quantity  Decimal        @db.Decimal(14, 3)
  unitCost  Decimal        @db.Decimal(14, 2)
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
}

// ---------- Customers & marketing ----------

model CustomerGroup {
  id          String  @id @default(cuid())
  name        String  @unique
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  customers   Customer[]
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String?      @unique
  email       String?
  address     String?
  nic         String?
  birthday    DateTime?
  groupId     String?
  tier        CustomerTier @default(SILVER)
  points      Int          @default(0)
  balance     Decimal      @default(0) @db.Decimal(14, 2)
  creditLimit Decimal      @default(0) @db.Decimal(14, 2)
  totalSpent  Decimal      @default(0) @db.Decimal(14, 2)
  visits      Int          @default(0)
  lastVisitAt DateTime?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  group       CustomerGroup? @relation(fields: [groupId], references: [id])
  sales       Sale[]
  ledger      CustomerLedger[]
  loyalty     LoyaltyEntry[]
  heldOrders  HeldOrder[]

  @@index([name])
}

model CustomerLedger {
  id         String   @id @default(cuid())
  customerId String
  amount     Decimal  @db.Decimal(14, 2) // +charge, -payment
  balance    Decimal  @db.Decimal(14, 2)
  type       String
  method     String?
  reference  String?
  refId      String?
  userId     String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
}

model LoyaltyEntry {
  id         String   @id @default(cuid())
  customerId String
  points     Int
  balance    Int
  reason     String
  refId      String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
}

model Promotion {
  id        String        @id @default(cuid())
  name      String
  type      PromotionType
  value     Decimal       @default(0) @db.Decimal(14, 2)
  buyQty    Int?
  getQty    Int?
  productIds  String[]
  categoryIds String[]
  branchIds   String[]
  startsAt  DateTime
  endsAt    DateTime?
  startHour Int?
  endHour   Int?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Decimal      @db.Decimal(14, 2)
  minSpend    Decimal      @default(0) @db.Decimal(14, 2)
  maxDiscount Decimal?     @db.Decimal(14, 2)
  usageLimit  Int?
  used        Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  sales       Sale[]
}

model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  initial   Decimal   @db.Decimal(14, 2)
  balance   Decimal   @db.Decimal(14, 2)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  entries   GiftCardEntry[]
}

model GiftCardEntry {
  id         String   @id @default(cuid())
  giftCardId String
  amount     Decimal  @db.Decimal(14, 2)
  balance    Decimal  @db.Decimal(14, 2)
  reason     String
  refId      String?
  createdAt  DateTime @default(now())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
}

// ---------- Sales ----------

model Sale {
  id          String     @id @default(cuid())
  number      String     @unique
  clientId    String?    @unique // idempotency key for retries and offline sync
  branchId    String
  terminalId  String?
  shiftId     String?
  cashierId   String
  customerId  String?
  couponId    String?
  tableId     String?
  status      SaleStatus @default(COMPLETED)
  subtotal    Decimal    @db.Decimal(14, 2)
  discount    Decimal    @default(0) @db.Decimal(14, 2)
  tax         Decimal    @default(0) @db.Decimal(14, 2)
  total       Decimal    @db.Decimal(14, 2)
  paid        Decimal    @default(0) @db.Decimal(14, 2)
  change      Decimal    @default(0) @db.Decimal(14, 2)
  refunded    Decimal    @default(0) @db.Decimal(14, 2)
  costTotal   Decimal    @default(0) @db.Decimal(14, 2)
  pointsEarned Int       @default(0)
  note        String?
  voidReason  String?
  voidedById  String?
  voidedAt    DateTime?
  soldAt      DateTime   @default(now())
  createdAt   DateTime   @default(now())
  branch      Branch     @relation(fields: [branchId], references: [id])
  terminal    Terminal?  @relation(fields: [terminalId], references: [id])
  shift       Shift?     @relation(fields: [shiftId], references: [id])
  cashier     User       @relation("SaleCashier", fields: [cashierId], references: [id])
  customer    Customer?  @relation(fields: [customerId], references: [id])
  coupon      Coupon?    @relation(fields: [couponId], references: [id])
  table       DiningTable? @relation(fields: [tableId], references: [id])
  items       SaleItem[]
  payments    Payment[]
  returns     SaleReturn[]
  kots        Kot[]

  @@index([branchId, soldAt])
  @@index([cashierId, soldAt])
  @@index([customerId, soldAt])
  @@index([soldAt])
}

model SaleItem {
  id           String  @id @default(cuid())
  saleId       String
  productId    String
  name         String
  variantLabel String?
  quantity     Decimal @db.Decimal(14, 3)
  returnedQty  Decimal @default(0) @db.Decimal(14, 3)
  unitPrice    Decimal @db.Decimal(14, 2)
  unitCost     Decimal @db.Decimal(14, 2)
  discount     Decimal @default(0) @db.Decimal(14, 2) // line + share of cart discount
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  tax          Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
  returnItems  SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String?
  returnId  String?
  shiftId   String?
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2) // negative for refunds
  reference String?
  createdAt DateTime      @default(now())
  sale      Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleReturn SaleReturn?  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  shift     Shift?        @relation(fields: [shiftId], references: [id])

  @@index([createdAt])
  @@index([method, createdAt])
}

model HeldOrder {
  id         String   @id @default(cuid())
  number     String   @unique
  branchId   String
  cashierId  String
  customerId String?
  note       String?
  cart       Json
  total      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId, createdAt])
}

model SaleReturn {
  id        String   @id @default(cuid())
  number    String   @unique
  saleId    String
  branchId  String
  shiftId   String?
  userId    String
  total     Decimal  @db.Decimal(14, 2)
  method    PaymentMethod
  note      String?
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  shift     Shift?   @relation(fields: [shiftId], references: [id])
  items     SaleReturnItem[]
  payments  Payment[]

  @@index([createdAt])
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  returnId   String
  saleItemId String
  quantity   Decimal    @db.Decimal(14, 3)
  amount     Decimal    @db.Decimal(14, 2)
  reason     String
  restock    Boolean    @default(true)
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
}

// ---------- Register ----------

model Shift {
  id           String      @id @default(cuid())
  number       String      @unique
  branchId     String
  terminalId   String?
  userId       String
  status       ShiftStatus @default(OPEN)
  openingFloat Decimal     @db.Decimal(14, 2)
  expectedCash Decimal?    @db.Decimal(14, 2)
  countedCash  Decimal?    @db.Decimal(14, 2)
  variance     Decimal?    @db.Decimal(14, 2)
  denominations Json?
  note         String?
  approvedById String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  branch       Branch      @relation(fields: [branchId], references: [id])
  terminal     Terminal?   @relation(fields: [terminalId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
  sales        Sale[]
  payments     Payment[]
  returns      SaleReturn[]
  cashMovements CashMovement[]

  @@index([branchId, openedAt])
  @@index([userId, status])
}

model CashMovement {
  id        String           @id @default(cuid())
  shiftId   String
  type      CashMovementType
  amount    Decimal          @db.Decimal(14, 2)
  reason    String
  userId    String
  createdAt DateTime         @default(now())
  shift     Shift            @relation(fields: [shiftId], references: [id])
}

// ---------- Expenses ----------

model ExpenseCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  budget Decimal? @db.Decimal(14, 2)
  active Boolean @default(true)
  expenses Expense[]
}

model Expense {
  id          String   @id @default(cuid())
  number      String   @unique
  branchId    String
  categoryId  String
  amount      Decimal  @db.Decimal(14, 2)
  method      String   @default("Cash")
  payee       String?
  description String?
  receiptKey  String?
  spentAt     DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([branchId, spentAt])
}

// ---------- Restaurant ----------

model DiningTable {
  id       String      @id @default(cuid())
  branchId String
  name     String
  area     String?
  seats    Int         @default(4)
  status   TableStatus @default(FREE)
  branch   Branch      @relation(fields: [branchId], references: [id])
  kots     Kot[]
  sales    Sale[]

  @@unique([branchId, name])
}

model Kot {
  id        String    @id @default(cuid())
  number    String    @unique
  branchId  String
  tableId   String?
  saleId    String?
  status    KotStatus @default(NEW)
  note      String?
  createdById String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id])
  table     DiningTable? @relation(fields: [tableId], references: [id])
  sale      Sale?     @relation(fields: [saleId], references: [id])
  items     KotItem[]

  @@index([branchId, status])
}

model KotItem {
  id        String  @id @default(cuid())
  kotId     String
  productId String
  name      String
  quantity  Decimal @db.Decimal(14, 3)
  note      String?
  kot       Kot     @relation(fields: [kotId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}
